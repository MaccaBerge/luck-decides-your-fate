# Required. The single admin password for /admin.
ADMIN_PASSWORD=change-me

# SQLite database file (point at a mounted volume when deployed).
DATABASE_PATH=./data/luckdecidesyourfate.db

# Public games idle for this many days are deleted (admin links never are).
GAME_TTL_DAYS=7

# Set to true when served over HTTPS.
COOKIE_SECURE=false

# Spin animation duration range in milliseconds.
SPIN_DURATION_MS_MIN=4500
SPIN_DURATION_MS_MAX=7000

# Built frontend; served by FastAPI if the directory exists.
FRONTEND_DIST=../frontend/dist
