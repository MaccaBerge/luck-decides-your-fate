# Required. The single admin password for /admin. Use a long random value in production.
ADMIN_PASSWORD=change-me

# SQLite database file; its parent directory is created if missing (production: /data/luckdecidesyourfate.db).
DATABASE_PATH=./data/luckdecidesyourfate.db

# Add Secure to the admin cookie and send HSTS: true/false/1/0/yes/no (production: true).
COOKIE_SECURE=false

# Public games idle for this many days are deleted (admin links never are).
GAME_TTL_DAYS=7

# Spin animation duration range in milliseconds (tests only; leave unset in production).
SPIN_DURATION_MS_MIN=4500
SPIN_DURATION_MS_MAX=7000

# Built frontend, served by FastAPI if the directory exists (the Dockerfile sets this).
FRONTEND_DIST=../frontend/dist

# Failed admin logins allowed per client IP inside the window before it gets a 429.
LOGIN_RATE_LIMIT_ATTEMPTS=5

# Length of the failed-login window, in seconds.
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Automatic backups to a private S3-compatible bucket. Leave all four unset to turn them off (setting only some stops startup).
# BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# BACKUP_S3_BUCKET=
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=

# Back up when the newest copy is at least this old (checked hourly), and keep this many copies.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
